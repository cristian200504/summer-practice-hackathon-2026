# ─────────────────────────────────────────────────────────────────────────────
# ShowUp2Move — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Full connection string: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:password@localhost:5432/showup2move
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
# bcrypt cost factor — minimum 12 (higher = slower but more secure)
BCRYPT_COST=12

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@showup2move.com

# ── OpenAI (NLP enrichment) ───────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# ── Google Places API (venue search) ─────────────────────────────────────────
# Enable "Places API" at https://console.cloud.google.com/apis/library
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ── OpenWeatherMap (weather forecasts) ───────────────────────────────────────
# Get your key at https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key

# ── Google Calendar API ───────────────────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=5242880

# ── Cron schedules (cron syntax) ─────────────────────────────────────────────
# Availability prompt: default 08:00 every day
AVAILABILITY_PROMPT_CRON=0 8 * * *
# Matching engine: default 12:00 every day (after response window)
MATCHING_ENGINE_CRON=0 12 * * *

# ── Matching ──────────────────────────────────────────────────────────────────
DEFAULT_PROXIMITY_KM=10

# ── Chatbot microservice (Python g4f) ─────────────────────────────────────────
# URL of the Python FastAPI chatbot service (packages/chatbot/)
# Start it with: cd packages/chatbot && uvicorn main:app --port 8000
CHATBOT_SERVICE_URL=http://localhost:8000
